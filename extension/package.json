{
  "name": "pi-mobile-bridge",
  "version": "0.1.0",
  "description": "LAN-direct WebSocket bridge: drive your pi/omp agent from the Pi Mobile iOS app. No relay, nothing leaves your network.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "lan",
    "websocket",
    "mobile",
    "ios",
    "remote-control"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --external:ws --external:@earendil-works/* --outfile=dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winmin/pi-mobile.git",
    "directory": "extension"
  }
}
